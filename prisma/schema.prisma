generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String // Tiptap HTML output
  excerpt     String?
  coverImage  String?
  ratingType  String? // "fire" | "knife"
  ratingCount Int? // 1-3
  city        String? // e.g. "Charlotte, NC"
  sourceUrl   String? // link to the original Substack post, if imported
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
